{
  "appId": "fr.vifi31.comptes",
  "appName": "Comptes",
  "webDir": "mobile/www",
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#1e1b4b"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1e1b4b",
    "scrollEnabled": true
  }
}
