# Configuration de Comptes — lue au démarrage du serveur (redémarrer après modification).
# Les variables déjà définies dans l'environnement Windows ont priorité sur ce fichier.

# Port d'écoute du serveur local (défaut : 3210)
COMPTES_PORT=3210

# Dossier des données de l'utilisateur (store.json, Releves, Sauvegardes, Rapports, Versions).
# Laisser commenté en développement : les données restent dans le dossier du projet.
# COMPTES_HOME=C:\Users\Vincent\Documents\Comptes

# Clé API du fournisseur d'IA (Anthropic ou compatible OpenAI), utilisée si aucune clé
# n'est enregistrée dans Analyse > Paramètres IA. Ne jamais partager ni versionner ce fichier.
# COMPTES_AI_KEY=
